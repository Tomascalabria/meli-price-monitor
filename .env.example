# ─── MELI OAuth (REQUERIDO) ────────────────────────────────────────────────
# 1. Entrá a https://developers.mercadolibre.com.ar/
# 2. Creá una app (gratis, sin review)
# 3. Copiá el App ID y Secret Key de la sección "Credenciales"
MELI_APP_ID=1234567890
MELI_APP_SECRET=aBcDeFgHiJkLmNoPqRsTuVwXyZ

# ─── Base de datos (OPCIONAL) ───────────────────────────────────────────────
# Por defecto crea data.db en la raíz del proyecto
# DATABASE_PATH=/ruta/personalizada/data.db

# ─── Cron (OPCIONAL) ────────────────────────────────────────────────────────
# Protege el endpoint /api/cron/scrape en producción
# CRON_SECRET=un-string-aleatorio-largo
