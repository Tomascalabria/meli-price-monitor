# Local dev: NO SETUP NEEDED — la DB SQLite se crea automáticamente en data.db

# Opcional: cambiar la ruta del archivo de base de datos
# DATABASE_PATH=/ruta/a/tu/data.db

# Para el cron job en producción (generá un string aleatorio)
# CRON_SECRET=un-string-secreto-aleatorio

# Para Turso (producción serverless — opcional)
# LIBSQL_URL=libsql://tu-db.turso.io
# LIBSQL_AUTH_TOKEN=tu-token
