# ─── MELI OAuth ────────────────────────────────────────────────────────────
# 1. Creá una app en https://developers.mercadolibre.com.ar/ (gratis)
# 2. Copiá App ID y Secret Key de la sección "Credenciales"
MELI_APP_ID=tu_app_id
MELI_APP_SECRET=tu_secret_key

# 3. Corré: node setup-meli-auth.mjs
#    Te guía para obtener el refresh token (se llena automáticamente)
MELI_REFRESH_TOKEN=

# ─── Base de datos (OPCIONAL) ───────────────────────────────────────────────
# Por defecto crea data.db en la raíz del proyecto
# DATABASE_PATH=/ruta/personalizada/data.db

# ─── Cron (OPCIONAL) ────────────────────────────────────────────────────────
# Protege el endpoint /api/cron/scrape en producción
# CRON_SECRET=un-string-aleatorio-largo
